{
  "schema": 1,
  "name": "impacket",
  "group": "active-directory",
  "description": "Impacket full toolkit (all example scripts as impacket-*)",
  "packaging": "svent",
  "package": "sv-impacket",
  "executables": [
    "impacket-secretsdump",
    "impacket-getuserspns",
    "impacket-getnpusers",
    "impacket-ntlmrelayx"
  ],
  "official_source": "https://github.com/fortra/impacket",
  "version_policy": "svent-packaged",
  "functional_test": [
    "impacket-secretsdump",
    "--help"
  ],
  "functional_test_any_exit": true,
  "isolation": {
    "kind": "venv",
    "prefix": "/opt/sv-impacket",
    "python": "/opt/sv-impacket/bin/python"
  },
  "upstream_version": "0.13.1"
}
