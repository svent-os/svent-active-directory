#!/usr/bin/make -f
PKG = sv-impacket
PREFIX = /opt/sv-impacket
DESTDIR = $(CURDIR)/debian/sv-impacket

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	rm -rf $(CURDIR)/.venv
	python3 -m venv $(CURDIR)/.venv
	$(CURDIR)/.venv/bin/pip install --no-cache-dir --upgrade pip wheel
	$(CURDIR)/.venv/bin/pip install --no-cache-dir impacket
	mkdir -p $(DESTDIR)$(PREFIX)
	cp -a $(CURDIR)/.venv/. $(DESTDIR)$(PREFIX)/
	find $(DESTDIR)$(PREFIX)/bin -type f -exec sed -i "1s|$(CURDIR)/.venv|$(PREFIX)|" {} +
	sed -i "s|$(CURDIR)/.venv|$(PREFIX)|g" $(DESTDIR)$(PREFIX)/pyvenv.cfg
	mkdir -p $(DESTDIR)/usr/bin
	for f in $(DESTDIR)$(PREFIX)/bin/*.py; do b=$$(basename "$$f"); n=$${b%.py}; n=$$(echo "$$n" | tr "A-Z" "a-z"); ln -sf $(PREFIX)/bin/$$b $(DESTDIR)/usr/bin/impacket-$$n; done
	mkdir -p $(DESTDIR)/usr/share/svent/catalog.d
	cp catalog.d/impacket.json $(DESTDIR)/usr/share/svent/catalog.d/

override_dh_strip:
override_dh_dwz:
override_dh_shlibdeps:
	dh_shlibdeps || true

override_dh_auto_clean:
	rm -rf $(CURDIR)/.venv
