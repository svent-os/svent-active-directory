#!/usr/bin/make -f
PKG = sv-enum4linux
PREFIX = /opt/sv-enum4linux
DESTDIR = $(CURDIR)/debian/sv-enum4linux

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	rm -rf $(CURDIR)/.src
	git clone --depth 1 https://github.com/CiscoCXSecurity/enum4linux $(CURDIR)/.src
	rm -rf $(CURDIR)/.src/.git
	mkdir -p $(DESTDIR)$(PREFIX)
	cp -a $(CURDIR)/.src/. $(DESTDIR)$(PREFIX)/
	mkdir -p $(DESTDIR)/usr/bin
	install -D -m755 files/enum4linux $(DESTDIR)/usr/bin/enum4linux
	mkdir -p $(DESTDIR)/usr/share/svent/catalog.d
	cp catalog.d/enum4linux.json $(DESTDIR)/usr/share/svent/catalog.d/

override_dh_auto_clean:
	rm -rf $(CURDIR)/.src $(CURDIR)/.venv
