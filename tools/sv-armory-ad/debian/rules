#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	python3 debian/armory.py build

override_dh_auto_install:
	python3 debian/armory.py install

override_dh_auto_clean:
	python3 debian/armory.py clean

override_dh_auto_test:
	python3 -c "import ast, pathlib; ast.parse(pathlib.Path('files/manager.py').read_text())"
